# Development-only defaults. Change them before a shared or production deployment.
POSTGRES_DB=fyp_grading_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_PORT=5433

BACKEND_PORT=8080
FRONTEND_PORT=3010

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Local Docker default: Mailpit captures SMTP messages at http://localhost:8025.
# For production, replace these values with the university SMTP service or SendGrid SMTP.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@squ.edu.om
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
MAIL_STARTTLS_REQUIRED=false
MAIL_HEALTH_ENABLED=false

# SendGrid SMTP example (production):
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=<SENDGRID_API_KEY>
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS_ENABLE=true
# MAIL_STARTTLS_REQUIRED=true

# Set a private random value of at least 32 characters for stable shared deployments.
# When empty, the backend creates an ephemeral local secret at startup.
APP_TOKEN_SECRET=

# Local demonstration only. Production must use a unique random value.
BOOTSTRAP_ADMIN_PASSWORD=Admin@123

# Public URL used in SSO callbacks and Industry Guest invitation e-mails.
APP_FRONTEND_URL=http://localhost:3010
APP_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*

# Keep true only for local demonstrations. Set false when SQU SSO is enabled.
LOCAL_INTERNAL_LOGIN_ENABLED=true
INDUSTRY_INVITATION_HOURS=48
PASSWORD_RESET_MINUTES=30
SIGNUP_CODE_MINUTES=10
TEMPORARY_PASSWORD_HOURS=24

# Obtain these OIDC values from the SQU identity-management team.
SQU_SSO_ENABLED=false
SQU_SSO_CLIENT_ID=
SQU_SSO_CLIENT_SECRET=
SQU_SSO_ISSUER_URI=
SQU_SSO_SCOPES=openid,profile,email
SQU_SSO_EMAIL_CLAIM=email
SQU_SSO_ALLOWED_DOMAIN=squ.edu.om
