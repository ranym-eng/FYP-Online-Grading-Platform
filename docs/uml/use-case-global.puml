@startuml
left to right direction
skinparam backgroundColor #F7F9FC
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam linetype ortho
skinparam usecase {
  BackgroundColor White
  BorderColor #334155
  ArrowColor #64748B
  FontColor #0F172A
}
skinparam package {
  BorderColor #1E3A5F
  BackgroundColor #F8FAFC
}
skinparam actor {
  BorderColor #1E3A5F
  FontColor #0F172A
}

title Sultan Qaboos University - FYP Online Grading Platform\nDiagramme global detaille des cas d'utilisation

actor "Utilisateur authentifie" as Authenticated <<abstrait>>
actor "Evaluateur" as Evaluator <<abstrait>>
actor "Administrateur" as Admin
actor "Superviseur" as Supervisor
actor "Evaluateur academique" as Faculty
actor "Representant industriel" as Industry
actor "Coordinateur FYP" as Coordinator
actor "Fichier Excel / CSV SQU" as Excel <<systeme externe>>
actor "Planificateur" as Scheduler <<systeme externe>>
actor "Serveur SMTP / Mailpit" as Mail <<systeme externe>>
actor "Collecteur institutionnel" as Collector <<systeme externe>>

Supervisor --|> Evaluator
Faculty --|> Evaluator
Industry --|> Evaluator
Evaluator --|> Authenticated
Admin --|> Authenticated
Coordinator --|> Authenticated

rectangle "FYP ONLINE GRADING PLATFORM" {
  package "1. Authentification et espace personnel" #EFF6FF {
    usecase "Se connecter par e-mail\net mot de passe" as UC_Login
    usecase "Verifier le compte actif\net les identifiants" as UC_CheckCredentials
    usecase "Creer une session personnelle" as UC_CreateSession
    usecase "Rediriger vers le dashboard\nselon le role" as UC_Redirect
    usecase "Consulter son dashboard" as UC_Dashboard
    usecase "Changer langue FR / EN" as UC_Language
    usecase "Changer theme clair / sombre" as UC_Theme
    usecase "Consulter son profil" as UC_Profile
    usecase "Se deconnecter" as UC_Logout
  }

  package "2. Administration des donnees academiques" #F8FAFC {
    usecase "Gerer les comptes acteurs\n(CRUD, role, statut)" as UC_Users
    usecase "Gerer les profils evaluateurs\n(interne / externe)" as UC_EvaluatorProfiles
    usecase "Gerer les fiches etudiantes\n(CRUD sans compte)" as UC_Students
    usecase "Previsualiser et valider\nun fichier etudiants" as UC_PreviewImport
    usecase "Importer / mettre a jour\nles etudiants" as UC_ImportStudents
    usecase "Controler stdID, cohorte,\nnom et e-mail SQU" as UC_ValidateStudentRows
    usecase "Gerer les filieres\nEIC / CSN / CSP / PSE" as UC_Tracks
    usecase "Gerer les projets FYP" as UC_Projects
    usecase "Gerer les equipes" as UC_Teams
    usecase "Ajouter / retirer les membres\nd'une equipe" as UC_TeamMembers
    usecase "Affecter un superviseur\na un projet" as UC_AssignSupervisor
    usecase "Affecter les evaluateurs\npar type de fiche" as UC_AssignEvaluators
    usecase "Rechercher et filtrer\nles donnees" as UC_Search
  }

  package "3. Phases, formulaires et regles" #FFF7ED {
    usecase "Creer / modifier une phase\nFYP I ou FYP II" as UC_Phases
    usecase "Definir debut et echeance" as UC_SetDeadline
    usecase "Ouvrir une phase" as UC_OpenPhase
    usecase "Fermer une phase" as UC_ClosePhase
    usecase "Archiver une phase" as UC_ArchivePhase
    usecase "Verifier l'acces effectif\na l'evaluation" as UC_CheckWindow
    usecase "Configurer les modeles\nd'evaluation" as UC_Forms
    usecase "Configurer les criteres,\nordre, maximum et poids" as UC_Criteria
    usecase "Activer / desactiver\nun formulaire" as UC_ActivateForm
    usecase "Configurer les ponderations\npar phase et type" as UC_GradeRules
  }

  package "4. Evaluations, brouillons et validation" #F0FDF4 {
    usecase "Consulter les projets, equipes\net phases affectes" as UC_Assignments
    usecase "Evaluer comme superviseur\nFYP I / FYP II" as UC_SupervisorForm
    usecase "Evaluer un rapport\nFYP I / FYP II" as UC_ReportForm
    usecase "Evaluer une soutenance\nFYP I / FYP II" as UC_OralForm
    usecase "Evaluer le Demo Day\nfiche Industry Guest" as UC_DemoForm
    usecase "Saisir les notes 0..10\net commentaires" as UC_FillScores
    usecase "Calculer la note de la fiche\nselon le bareme" as UC_CalculateSheet
    usecase "Enregistrer automatiquement\nle brouillon dans PostgreSQL" as UC_AutoSave
    usecase "Enregistrer manuellement\nle brouillon" as UC_SaveDraft
    usecase "Reprendre un brouillon" as UC_ResumeDraft
    usecase "Valider et soumettre\nla fiche" as UC_Submit
    usecase "Verifier l'identite\nde l'evaluateur" as UC_CheckIdentity
    usecase "Verifier l'affectation\nprojet / type" as UC_CheckAssignment
    usecase "Verifier tous les criteres\nobligatoires" as UC_CheckComplete
    usecase "Verrouiller et horodater\nla fiche" as UC_Lock
    usecase "Refuser toute modification\napres validation" as UC_PreventEdit
    usecase "Consulter l'historique\ndes fiches" as UC_History
    usecase "Demander une prolongation\napres l'echeance" as UC_RequestExtension
    usecase "Consulter ses demandes\nde prolongation" as UC_MyExtensions
  }

  package "5. Prolongations et notifications" #FFFBEB {
    usecase "Consulter les demandes\nde prolongation" as UC_AllExtensions
    usecase "Approuver une prolongation\net fixer une echeance personnelle" as UC_ApproveExtension
    usecase "Rejeter une prolongation" as UC_RejectExtension
    usecase "Notifier la decision" as UC_NotifyDecision
    usecase "Detecter une echeance\na moins de 24 h" as UC_Reminder24
    usecase "Detecter une echeance\na moins de 12 h" as UC_Reminder12
    usecase "Creer une notification\ninterne personnelle" as UC_InApp
    usecase "Consulter la cloche\net le centre de notifications" as UC_Notifications
    usecase "Marquer une notification lue" as UC_MarkRead
    usecase "Tout marquer comme lu" as UC_MarkAllRead
    usecase "Envoyer et tracer\nun e-mail" as UC_Email
    usecase "Relancer un e-mail en echec" as UC_RetryEmail
  }

  package "6. Consolidation, publication et reporting" #F5F3FF {
    usecase "Suivre les fiches en attente\net la progression" as UC_Progress
    usecase "Calculer la note d'une phase" as UC_Consolidate
    usecase "Verifier toutes les evaluations\nrequises" as UC_CheckRequired
    usecase "Inclure uniquement les\nfiches verrouillees" as UC_LockedOnly
    usecase "Exclure les brouillons, meme\nenregistres ou expires" as UC_ExcludeDrafts
    usecase "Appliquer les ponderations\nde la phase" as UC_ApplyWeights
    usecase "Recalculer une note" as UC_Recalculate
    usecase "Publier / depublier\nles notes" as UC_Publish
    usecase "Consulter les notes\nconsolidees" as UC_ViewGrades
    usecase "Generer un rapport de phase" as UC_PhaseReport
    usecase "Generer un rapport final" as UC_FinalReport
    usecase "Envoyer le rapport\nau collecteur" as UC_SendReport
    usecase "Consulter l'historique\ndes rapports et envois" as UC_ReportHistory
    usecase "Consulter le journal d'audit" as UC_Audit
    usecase "Tester les API via Swagger\nou la console integree" as UC_API
  }
}

Authenticated -- UC_Login
Authenticated -- UC_Dashboard
Authenticated -- UC_Language
Authenticated -- UC_Theme
Authenticated -- UC_Profile
Authenticated -- UC_Notifications
Authenticated -- UC_Logout

UC_Login ..> UC_CheckCredentials : <<include>>
UC_Login ..> UC_CreateSession : <<include>>
UC_Login ..> UC_Redirect : <<include>>
UC_Notifications ..> UC_MarkRead : <<include>>
UC_Notifications ..> UC_MarkAllRead : <<extend>>

Admin -- UC_Users
Admin -- UC_EvaluatorProfiles
Admin -- UC_Students
Admin -- UC_PreviewImport
Admin -- UC_ImportStudents
Admin -- UC_Tracks
Admin -- UC_Projects
Admin -- UC_Teams
Admin -- UC_TeamMembers
Admin -- UC_AssignSupervisor
Admin -- UC_AssignEvaluators
Admin -- UC_Search
Admin -- UC_Phases
Admin -- UC_Forms
Admin -- UC_GradeRules
Admin -- UC_AllExtensions
Admin -- UC_ApproveExtension
Admin -- UC_RejectExtension
Admin -- UC_Progress
Admin -- UC_Consolidate
Admin -- UC_Recalculate
Admin -- UC_Publish
Admin -- UC_PhaseReport
Admin -- UC_FinalReport
Admin -- UC_SendReport
Admin -- UC_ReportHistory
Admin -- UC_Audit
Admin -- UC_API
Admin -- UC_RetryEmail

Excel -- UC_PreviewImport
UC_PreviewImport ..> UC_ValidateStudentRows : <<include>>
UC_ImportStudents ..> UC_PreviewImport : <<include>>
UC_Teams ..> UC_TeamMembers : <<include>>
UC_Projects ..> UC_AssignSupervisor : <<extend>>
UC_Projects ..> UC_AssignEvaluators : <<extend>>
UC_Phases ..> UC_SetDeadline : <<include>>
UC_OpenPhase ..> UC_CheckWindow : <<include>>
UC_Forms ..> UC_Criteria : <<include>>
UC_Forms ..> UC_ActivateForm : <<extend>>

Evaluator -- UC_Assignments
Evaluator -- UC_FillScores
Evaluator -- UC_SaveDraft
Evaluator -- UC_ResumeDraft
Evaluator -- UC_Submit
Evaluator -- UC_History
Evaluator -- UC_RequestExtension
Evaluator -- UC_MyExtensions
Supervisor -- UC_SupervisorForm
Faculty -- UC_ReportForm
Faculty -- UC_OralForm
Industry -- UC_DemoForm

UC_SupervisorForm ..> UC_FillScores : <<include>>
UC_ReportForm ..> UC_FillScores : <<include>>
UC_OralForm ..> UC_FillScores : <<include>>
UC_DemoForm ..> UC_FillScores : <<include>>
UC_FillScores ..> UC_CalculateSheet : <<include>>
UC_FillScores ..> UC_AutoSave : <<include>>
UC_SaveDraft ..> UC_CheckIdentity : <<include>>
UC_SaveDraft ..> UC_CheckAssignment : <<include>>
UC_SaveDraft ..> UC_CheckWindow : <<include>>
UC_Submit ..> UC_CheckIdentity : <<include>>
UC_Submit ..> UC_CheckAssignment : <<include>>
UC_Submit ..> UC_CheckWindow : <<include>>
UC_Submit ..> UC_CheckComplete : <<include>>
UC_Submit ..> UC_Lock : <<include>>
UC_Lock ..> UC_PreventEdit : <<include>>
UC_RequestExtension ..> UC_CheckWindow : <<extend>>

UC_ApproveExtension ..> UC_NotifyDecision : <<include>>
UC_RejectExtension ..> UC_NotifyDecision : <<include>>
UC_NotifyDecision ..> UC_Email : <<include>>
UC_NotifyDecision ..> UC_InApp : <<include>>
Scheduler -- UC_Reminder24
Scheduler -- UC_Reminder12
UC_Reminder24 ..> UC_InApp : <<include>>
UC_Reminder12 ..> UC_InApp : <<include>>
Mail -- UC_Email

Admin -- UC_CheckWindow
Admin -- UC_OpenPhase
Admin -- UC_ClosePhase
Admin -- UC_ArchivePhase

UC_Consolidate ..> UC_CheckRequired : <<include>>
UC_Consolidate ..> UC_LockedOnly : <<include>>
UC_LockedOnly ..> UC_ExcludeDrafts : <<include>>
UC_Consolidate ..> UC_ApplyWeights : <<include>>
UC_Recalculate ..> UC_Consolidate : <<include>>
UC_PhaseReport ..> UC_ViewGrades : <<include>>
UC_FinalReport ..> UC_ViewGrades : <<include>>
UC_SendReport ..> UC_Email : <<include>>
Collector -- UC_SendReport

Coordinator -- UC_Progress
Coordinator -- UC_ViewGrades
Coordinator -- UC_PhaseReport
Coordinator -- UC_FinalReport
Coordinator -- UC_SendReport
Coordinator -- UC_ReportHistory
@enduml
