digraph FYP_Class_Model {
  graph [
    rankdir=LR,
    compound=true,
    newrank=true,
    splines=ortho,
    overlap=false,
    bgcolor="#F8FAFC",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.85",
    fontname="Segoe UI",
    fontsize=24,
    labelloc=t,
    label="Sultan Qaboos University - FYP Online Grading Platform\nDiagramme global de classes metier"
  ];

  node [
    shape=record,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#1F2937",
    penwidth=1.15,
    fontname="Segoe UI",
    fontsize=10,
    margin="0.09,0.06"
  ];
  edge [
    color="#475569",
    penwidth=1.0,
    arrowsize=0.7,
    fontname="Segoe UI",
    fontsize=9,
    labeldistance=1.4
  ];

  BaseEntity [
    fillcolor="#E2E8F0",
    label="{<<MappedSuperclass>>\nBaseEntity|- id: UUID\l- createdAt: LocalDateTime\l- updatedAt: LocalDateTime\l}"
  ];

  subgraph cluster_identity {
    label="01 - Identity and access";
    style="rounded,filled";
    color="#60A5FA";
    fillcolor="#EFF6FF";

    User [label="{<<Entity>>\nUser|- universityId: String\l- fullName: String\l- email: String\l- passwordHash: String\l- phone: String\l- role: UserRole\l- status: UserStatus\l}"];
    EvaluatorProfile [label="{<<Entity>>\nEvaluatorProfile|- department: String\l- specialization: String\l- externalOrganization: String\l- external: boolean\l}"];
    StudentProfile [fillcolor="#FFF7ED", color="#F97316", label="{<<Academic Record>>\nStudentProfile|- firstName: String\l- lastName: String\l- studentNumber: String {unique}\l- academicYear: String\l- trackCode: String\l- level: String\l}"];
  }

  subgraph cluster_project {
    label="02 - Projects, teams and assignments";
    style="rounded,filled";
    color="#38BDF8";
    fillcolor="#F0F9FF";

    Track [label="{<<Entity>>\nTrack|- code: String {unique}\l- name: String\l- description: String\l- active: boolean\l}"];
    Project [label="{<<Entity>>\nProject|- title: String\l- abstractText: String\l- academicYear: String\l- status: String\l}"];
    Team [label="{<<Entity>>\nTeam|- name: String\l- section: String\l- academicYear: String\l}"];
    ProjectSupervisorAssignment [fillcolor="#ECFEFF", label="{<<Association Entity>>\nProjectSupervisorAssignment|- active: boolean\l}"];
    ProjectEvaluatorAssignment [fillcolor="#ECFEFF", label="{<<Association Entity>>\nProjectEvaluatorAssignment|- evaluationType: EvaluationType\l- active: boolean\l}"];
  }

  subgraph cluster_phase {
    label="03 - Phase calendar";
    style="rounded,filled";
    color="#F59E0B";
    fillcolor="#FFFBEB";

    Phase [label="{<<Entity>>\nPhase|- type: PhaseType\l- name: String\l- academicYear: String\l- startDate: LocalDateTime\l- deadline: LocalDateTime\l- status: PhaseStatus\l}"];
    PhaseExtensionRequest [label="{<<Entity>>\nPhaseExtensionRequest|- reason: String\l- requestedDeadline: LocalDateTime\l- status: ExtensionRequestStatus\l- requestedAt: LocalDateTime\l- reviewedAt: LocalDateTime\l- extendedDeadline: LocalDateTime\l- adminComment: String\l}"];
  }

  subgraph cluster_evaluation {
    label="04 - Evaluation model";
    style="rounded,filled";
    color="#4ADE80";
    fillcolor="#F0FDF4";

    EvaluationFormTemplate [label="{<<Entity>>\nEvaluationFormTemplate|- name: String\l- evaluationType: EvaluationType\l- phaseType: PhaseType\l- description: String\l- totalWeight: double\l- active: boolean\l}"];
    RubricCriterion [label="{<<Entity>>\nRubricCriterion|- title: String\l- description: String\l- maxScore: double\l- weight: double\l- displayOrder: int\l- required: boolean\l}"];
    EvaluationSubmission [fillcolor="#F7FEE7", label="{<<Entity>>\nEvaluationSubmission|- evaluationType: EvaluationType\l- status: SubmissionStatus\l- locked: boolean\l- draftSavedAt: LocalDateTime\l- submittedAt: LocalDateTime\l- lockedAt: LocalDateTime\l- totalScore: double\l- requiredScoreCount: Integer\l- completedScoreCount: Integer\l- generalComment: String\l}"];
    CriterionScore [label="{<<Entity>>\nCriterionScore|- score: double\l- comment: String\l}"];
  }

  subgraph cluster_results {
    label="05 - Grades, reports and traceability";
    style="rounded,filled";
    color="#A78BFA";
    fillcolor="#F5F3FF";

    GradeRule [label="{<<Entity>>\nGradeRule|- phaseType: PhaseType\l- evaluationType: EvaluationType\l- weight: double\l- active: boolean\l}"];
    Grade [label="{<<Entity>>\nGrade|- phaseType: PhaseType\l- rawScore: double\l- weightedScore: double\l- finalScore: double\l- published: boolean\l}"];
    Report [label="{<<Entity>>\nReport|- filePath: String\l- status: ReportStatus\l- generatedAt: LocalDateTime\l- sentAt: LocalDateTime\l- recipientEmail: String\l- contentSnapshot: String\l}"];
    EmailNotification [label="{<<Entity>>\nEmailNotification|- recipient: String\l- recipientUserId: UUID\l- subject: String\l- status: String\l- category: String\l- severity: String\l- deduplicationKey: String\l- actionView: String\l- readAt: LocalDateTime\l}"];
    AuditLog [label="{<<Entity>>\nAuditLog|- userId: UUID\l- action: String\l- entityType: String\l- entityId: UUID\l- oldValue: String\l- newValue: String\l- ipAddress: String\l- userAgent: String\l}"];
  }

  subgraph cluster_enums {
    label="Business enumerations";
    style="rounded,filled";
    color="#94A3B8";
    fillcolor="#F8FAFC";

    UserRole [fillcolor="#F1F5F9", label="{<<enum>>\nUserRole|ADMIN\lSUPERVISOR\lFACULTY_EVALUATOR\lINDUSTRY_REPRESENTATIVE\lCOORDINATOR\l}"];
    UserStatus [fillcolor="#F1F5F9", label="{<<enum>>\nUserStatus|ACTIVE\lINACTIVE\lSUSPENDED\l}"];
    PhaseType [fillcolor="#F1F5F9", label="{<<enum>>\nPhaseType|PHASE_I\lPHASE_II\l}"];
    PhaseStatus [fillcolor="#F1F5F9", label="{<<enum>>\nPhaseStatus|NOT_STARTED\lOPEN\lCLOSED\lARCHIVED\l}"];
    EvaluationType [fillcolor="#F1F5F9", label="{<<enum>>\nEvaluationType|SUPERVISOR_PHASE_I\lREPORT_PHASE_I\lORAL_PHASE_I\lSUPERVISOR_PHASE_II\lREPORT_PHASE_II\lORAL_PHASE_II\lDEMO_DAY_INDUSTRY\l}"];
    SubmissionStatus [fillcolor="#F1F5F9", label="{<<enum>>\nSubmissionStatus|DRAFT\lSUBMITTED\lLOCKED\l}"];
    ExtensionRequestStatus [fillcolor="#F1F5F9", label="{<<enum>>\nExtensionRequestStatus|PENDING\lAPPROVED\lREJECTED\l}"];
    ReportStatus [fillcolor="#F1F5F9", label="{<<enum>>\nReportStatus|PENDING\lGENERATED\lSENT\lFAILED\l}"];
  }

  Legend [shape=note, fillcolor="#FFFFFF", color="#64748B", label="Legend\nsolid line: JPA/business association\nfilled diamond: composition\nempty diamond: aggregation\ndashed line: logical reference or rule use\nAll entities extend BaseEntity."];

  // layout backbone
  BaseEntity -> User [style=invis, weight=50];
  User -> Track [style=invis, weight=60];
  Track -> Phase [style=invis, weight=60];
  Phase -> EvaluationFormTemplate [style=invis, weight=60];
  EvaluationFormTemplate -> GradeRule [style=invis, weight=60];

  { rank=same; User; EvaluatorProfile; StudentProfile; }
  { rank=same; Track; Project; Team; }
  { rank=same; ProjectSupervisorAssignment; ProjectEvaluatorAssignment; }
  { rank=same; Phase; PhaseExtensionRequest; }
  { rank=same; EvaluationFormTemplate; RubricCriterion; EvaluationSubmission; CriterionScore; }
  { rank=same; GradeRule; Grade; Report; EmailNotification; AuditLog; }

  // identity
  User -> EvaluatorProfile [dir=none, label="1 profile 0..1"];

  // projects and teams
  Track -> Project [dir=none, label="1 classifies 0..*"];
  Project -> Team [dir=none, label="1 assigned team 0..1"];
  Team -> StudentProfile [dir=both, arrowtail=odiamond, arrowhead=none, label="0..* members 0..*"];
  Project -> ProjectSupervisorAssignment [dir=both, arrowtail=diamond, arrowhead=none, label="1 supervisorships 0..*"];
  Project -> ProjectEvaluatorAssignment [dir=both, arrowtail=diamond, arrowhead=none, label="1 evaluator slots 0..*"];
  EvaluatorProfile -> ProjectSupervisorAssignment [dir=none, label="1 supervisor 0..*"];
  EvaluatorProfile -> ProjectEvaluatorAssignment [dir=none, label="1 evaluator 0..*"];

  // phases and extensions
  Phase -> PhaseExtensionRequest [dir=both, arrowtail=diamond, arrowhead=none, label="1 extension requests 0..*"];
  User -> PhaseExtensionRequest [dir=none, label="requester 1 to 0..*"];
  User -> PhaseExtensionRequest [dir=none, color="#94A3B8", fontcolor="#64748B", label="reviewer 0..1 to 0..*"];

  // evaluation core
  EvaluationFormTemplate -> RubricCriterion [dir=both, arrowtail=diamond, arrowhead=none, label="1 criteria 1..*"];
  Project -> EvaluationSubmission [dir=none, label="1 submissions 0..*"];
  Phase -> EvaluationSubmission [dir=none, label="1 submissions 0..*"];
  EvaluationFormTemplate -> EvaluationSubmission [dir=none, label="1 template 0..*"];
  EvaluatorProfile -> EvaluationSubmission [dir=none, label="1 submitted by 0..*"];
  EvaluationSubmission -> CriterionScore [dir=both, arrowtail=diamond, arrowhead=none, label="1 scores 0..*"];
  RubricCriterion -> CriterionScore [dir=none, label="1 criterion 0..*"];
  ProjectEvaluatorAssignment -> EvaluationSubmission [style=dashed, arrowhead=open, label="authorizes"];

  // results and support
  Project -> Grade [dir=none, label="1 grades 0..*"];
  Phase -> Grade [dir=none, label="1 grades 0..*"];
  Project -> Report [dir=none, label="1 reports 0..*"];
  Phase -> Report [dir=none, label="0..1 reports 0..*"];
  GradeRule -> Grade [style=dashed, arrowhead=open, label="calculation rule"];
  User -> EmailNotification [style=dashed, arrowhead=none, label="recipientUserId"];
  User -> AuditLog [style=dashed, arrowhead=none, label="userId"];

  // enum references, intentionally compact
  User -> UserRole [style=dashed, arrowhead=open, constraint=false];
  User -> UserStatus [style=dashed, arrowhead=open, constraint=false];
  Phase -> PhaseType [style=dashed, arrowhead=open, constraint=false];
  Phase -> PhaseStatus [style=dashed, arrowhead=open, constraint=false];
  EvaluationSubmission -> SubmissionStatus [style=dashed, arrowhead=open, constraint=false];
  EvaluationSubmission -> EvaluationType [style=dashed, arrowhead=open, constraint=false];
  PhaseExtensionRequest -> ExtensionRequestStatus [style=dashed, arrowhead=open, constraint=false];
  Report -> ReportStatus [style=dashed, arrowhead=open, constraint=false];
  GradeRule -> PhaseType [style=dashed, arrowhead=open, constraint=false];
  GradeRule -> EvaluationType [style=dashed, arrowhead=open, constraint=false];
}
