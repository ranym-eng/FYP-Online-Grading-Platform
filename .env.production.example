# Public Azure DNS name, without https://
APP_DOMAIN=fyp-grading-demo.westeurope.cloudapp.azure.com
ACME_EMAIL=administrator@example.com

IMAGE_TAG=latest

POSTGRES_DB=fyp_grading_platform
POSTGRES_USER=fyp_platform
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_TOKEN_SECRET=replace-with-at-least-64-random-characters
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-long-random-password

# Demonstration authentication. Disable when SQU OIDC is configured.
LOCAL_INTERNAL_LOGIN_ENABLED=true
SQU_SSO_ENABLED=false
SQU_SSO_CLIENT_ID=
SQU_SSO_CLIENT_SECRET=
SQU_SSO_ISSUER_URI=
SQU_SSO_SCOPES=openid,profile,email
SQU_SSO_EMAIL_CLAIM=email
SQU_SSO_ALLOWED_DOMAIN=squ.edu.om

INDUSTRY_INVITATION_HOURS=48
PASSWORD_RESET_MINUTES=30

# Internal Mailpit capture is the zero-cost default. Replace with SQU SMTP or
# SendGrid SMTP when real external delivery is required.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@squ.edu.om
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
MAIL_STARTTLS_REQUIRED=false
